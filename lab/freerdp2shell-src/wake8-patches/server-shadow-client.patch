+/* Wake-8 lab-only synthetic audio playback event. Posts a real
+ * SHADOW_MSG_OUT_AUDIO_OUT_SAMPLES through the normal shadow message path so
+ * the real rdpsnd_server_send_samples() CopyMemory runs in the live process. */
+BOOL shadow_client_post_msg(rdpShadowClient* client, void* context, UINT32 type,
+                            SHADOW_MSG_OUT* msg, void* lParam);
+
+static void wake8_audio_free(UINT32 id, SHADOW_MSG_OUT* msg)
+{
+	(void)id;
+	free(msg);
+}
+
+static DWORD WINAPI wake8_audio_thread(LPVOID arg)
+{
+	rdpShadowClient* client = (rdpShadowClient*)arg;
+	WLog_INFO(TAG, "wake8 audio thread started");
+	Sleep(1200);
+	SHADOW_MSG_OUT_AUDIO_OUT_SAMPLES* m = calloc(1, sizeof(*m));
+	AUDIO_FORMAT* fmt = calloc(1, sizeof(*fmt));
+	BYTE* data = malloc(16384);
+	if (!m || !fmt || !data)
+		return 1;
+	fmt->wFormatTag = WAVE_FORMAT_PCM;
+	fmt->nChannels = 2;
+	fmt->nSamplesPerSec = 44100;
+	fmt->nAvgBytesPerSec = 176400;
+	fmt->nBlockAlign = 4;
+	fmt->wBitsPerSample = 16;
+	memset(data, 0xDE, 16384);
+	m->common.Free = wake8_audio_free;
+	m->audio_format = fmt;
+	m->buf = data;
+	m->nFrames = 4096;
+	m->wTimestamp = 0;
+	WLog_INFO(TAG, "wake8 injecting synthetic audio playback");
+	shadow_client_post_msg(client, NULL, SHADOW_MSG_OUT_AUDIO_OUT_SAMPLES_ID,
+	                       (SHADOW_MSG_OUT*)m, NULL);
+	return 0;
+}
