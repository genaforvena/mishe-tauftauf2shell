# Build trees are reproducible from pinned/LibRaw-0.22.3.tar.gz + pinned/fix-894.patch
# via bootstrap.sh; never commit their objects, archives or binaries.
/pinned/LibRaw-0.22.3/
/fixed/LibRaw-0.22.3/
/plain/LibRaw-0.22.3/
/o0/LibRaw-0.22.3/
*.o
*.a
*.ppm
*.out.bin
/trace.txt
/run-output.txt
/w10/*
!/w10/*.gdb
!/w10/prediction.txt
!/w10/instrument.patch
!/w10/results.txt
!/w10/target*.input
!/w10/grid-*.txt
!/w10/dead-gdb-*.txt
!/w10/target2222-gdb-*.txt
!/w10/dead-asan-*.out
!/w10/target2222-asan-*.out
/wire/wire-decoder
/wire/wire-*.out
/wire/wire-out/
/wire/wire-run*/
/replay-out/

# W21: replay outputs are regenerable; keep the pinned evidence and probes.
/w21/*
!/w21/hashes.sha256
!/w21/hashes-clean.sha256
!/w21/results.txt
!/w21/replay.sh
!/w21/zero.json
!/w21/zero.input
!/w21/sizefield*.gdb
!/w21/sizefield-*.txt
!/w21/tophdr.gdb
!/w21/postloop.gdb
!/w21/pad16777216-o0.err
!/w21/pad16777216-plain.err
!/w21/zero-o0-n1.err

# W29: derived inputs and replay outputs are regenerated by w29/replay.sh
# from the committed specs and probe; keep only the pins and evidence.
/w29/red18.input
/w29/red11.input
/w29/replay-hashes.out
/w29/replay-gdb-red18.txt
/w29/replay-*-red18.err
/w29/replay-*-red11.err
