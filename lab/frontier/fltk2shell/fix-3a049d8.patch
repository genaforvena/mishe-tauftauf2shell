From 3a049d8262dc759cf9737339420e8457e24c0cb1 Mon Sep 17 00:00:00 2001
From: ManoloFLTK <41016272+ManoloFLTK@users.noreply.github.com>
Date: Thu, 22 Oct 2026 16:17:50 +0200
Subject: [PATCH] Fix "BMP Image Loader: Stack and Heap Buffer Overflow via
 Crafted BMP File" (#1632)

Many thanks to @Haind03 for detecting the issue and sharing a fix.
---
 src/Fl_BMP_Image.cxx | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/Fl_BMP_Image.cxx b/src/Fl_BMP_Image.cxx
index 1386cb8b7f..5a48bc0f84 100644
--- a/src/Fl_BMP_Image.cxx
+++ b/src/Fl_BMP_Image.cxx
@@ -284,6 +284,10 @@ void Fl_BMP_Image::load_bmp_(Fl_Image_Reader &rdr, int ico_height, int ico_width
   if (colors_used == 0 && depth <= 8)
     colors_used = 1 << depth;
 
+  if (colors_used > 256) {
+    ld(ERR_FORMAT);
+    return;
+  }
   for (int i = 0; i < colors_used; i++) {
     // Read BGR color...
     colormap[i][0] = rdr.read_byte();
@@ -318,7 +322,7 @@ void Fl_BMP_Image::load_bmp_(Fl_Image_Reader &rdr, int ico_height, int ico_width
     ld(ERR_FORMAT);
     return;
   }
-  array = new uchar[width * height * dstBDepth];
+  array = new uchar[(size_t)width * height * dstBDepth];
   alloc_array = 1;
 
   // Read the image data...
