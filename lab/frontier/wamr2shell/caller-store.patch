+/* wamr2shell wake-2 CALLER-STORE probe (not upstream): log the would-be OOB
+   write, but RETURN FALSE so the emitter performs its own real store
+   (bh_memcpy_s / STORE_U* / STORE_PTR) at the real destination. A separate
+   readback helper logs the bytes physically resident after that store. */
+static bool
+wamr_oob_log(WASMLoaderContext *ctx, const void *value, uint32 size,
+             const char *tag)
+{
+    uintptr_t a = (uintptr_t)ctx->p_code_compiled;
+    uintptr_t e = (uintptr_t)ctx->p_code_compiled_end;
+    if (a + size > e) {
+        fprintf(stderr,
+                "WAMR_CALLER tag=%s phase=before size=%u dest=0x%llx past=%llu in=",
+                tag, size, (unsigned long long)a,
+                (unsigned long long)(a + size - e));
+        for (uint32 i = 0; i < size; i++)
+            fprintf(stderr, "%02x", ((const uint8 *)value)[i]);
+        fprintf(stderr, "\n");
+    }
+    return false;
+}
+
 static void
+wamr_oob_readback(WASMLoaderContext *ctx, uint32 size)
+{
+    uintptr_t a = (uintptr_t)ctx->p_code_compiled;
+    uintptr_t e = (uintptr_t)ctx->p_code_compiled_end;
+    if (a + size > e) {
+        const uint8 *p = (const uint8 *)a;
+        fprintf(stderr,
+                "WAMR_CALLER tag=const phase=after size=%u dest=0x%llx past=%llu mem=",
+                size, (unsigned long long)a,
+                (unsigned long long)(a + size - e));
+        for (uint32 i = 0; i < size; i++)
+            fprintf(stderr, "%02x", p[i]);
+        fprintf(stderr, "\n");
+    }
+}
