+/* W90 frontier instrumentation (not upstream): record every would-be write
+   past the Pass-1-sized code buffer, skip the real store, keep the cursor
+   advancing so the full Pass-2 sequence is observable under ASan. */
+static bool
+wamr_oob_log(WASMLoaderContext *ctx, const void *value, uint32 size,
+             const char *tag)
+{
+    uintptr_t a = (uintptr_t)ctx->p_code_compiled;
+    uintptr_t e = (uintptr_t)ctx->p_code_compiled_end;
+    if (a + size > e) {
+        fprintf(stderr, "WAMR_OOB tag=%s size=%u past=%llu bytes=", tag, size,
+                (unsigned long long)(a + size - e));
+        for (uint32 i = 0; i < size; i++)
+            fprintf(stderr, "%02x", ((const uint8 *)value)[i]);
+        fprintf(stderr, "\n");
+        return true;
+    }
+    return false;
+}
