+/* wamr2shell wake-2 PASSIVE probe (not upstream): for a write past the
+   Pass-1-sized code buffer, perform the REAL store at the real destination,
+   then read the bytes back and log both the input and the resident bytes.
+   Returning true makes the caller skip its own (equivalent) store; the
+   cursor advances identically in both the skipping and passive builds. */
+static bool
+wamr_oob_log(WASMLoaderContext *ctx, const void *value, uint32 size,
+             const char *tag)
+{
+    uintptr_t a = (uintptr_t)ctx->p_code_compiled;
+    uintptr_t e = (uintptr_t)ctx->p_code_compiled_end;
+    if (a + size > e) {
+        memcpy((void *)a, value, size);
+        fprintf(stderr,
+                "WAMR_PASSIVE tag=%s size=%u dest=0x%llx past=%llu in=", tag,
+                size, (unsigned long long)a,
+                (unsigned long long)(a + size - e));
+        for (uint32 i = 0; i < size; i++)
+            fprintf(stderr, "%02x", ((const uint8 *)value)[i]);
+        fprintf(stderr, " mem=");
+        for (uint32 i = 0; i < size; i++)
+            fprintf(stderr, "%02x", ((const uint8 *)a)[i]);
+        fprintf(stderr, "\n");
+        return true;
+    }
+    return false;
+}
