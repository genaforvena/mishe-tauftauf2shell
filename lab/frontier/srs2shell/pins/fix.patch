+        0x12, 0x34, 0x56, 0x78  // SSRC of packet sender
+    };
+    SrsBuffer buffer((char *)data, sizeof(data));
+    SrsRtcpCompound compound;
+    srs_error_t err = compound.decode(&buffer);
+    EXPECT_TRUE(err != srs_success);
+    srs_freep(err);
+}
+
