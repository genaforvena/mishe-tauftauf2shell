+				if (ks) {
+					unsigned long long v = strtoull(ks, NULL, 0);
+					int i;
+					for (i = 0; i < 8; i++)
+						bytes[0x3E28+i] = (char)((v >> (8*i)) & 0xff);
+				}
+				if (rs) {
+					unsigned long long v = strtoull(rs, NULL, 0);
+					int i;
+					for (i = 0; i < 8; i++)
+						bytes[0x3E38+i] = (char)((v >> (8*i)) & 0xff);
+				}
+			}
