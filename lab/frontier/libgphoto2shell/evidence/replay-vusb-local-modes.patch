+					unsigned long long v = strtoull(ts, NULL, 0);
+					int i;
+					for (i = 0; i < 8; i++)
+						bytes[0x3E30+i] = (char)((v >> (8*i)) & 0xff);
+				}
+			}
+			if (m2[0] == 'c' && n >= 0x3E40) {
+				const char *ks = getenv("M2SHELL_JL2005_CANARY");
