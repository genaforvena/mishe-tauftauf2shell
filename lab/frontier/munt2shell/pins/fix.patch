From 1749f7fed5cdb3a9015acce076a1512b1615dc3b Mon Sep 17 00:00:00 2001
From: sergm <sergm@bigmir.net>
Date: Mon, 2 Nov 2026 19:07:20 +0100
Subject: [PATCH] mt32emu: Fixed heap buffer overflow in
 `MidiStreamParserImpl::parseSysex` (#149)

Also added the test cases to `MidiStreamParserTest` to cover the related
behaviour.
---
 mt32emu/NEWS.txt                          |  8 +++++
 mt32emu/src/MidiStreamParser.cpp          | 14 +++++---
 mt32emu/src/test/MidiStreamParserTest.cpp | 40 +++++++++++++++++++++++
 3 files changed, 57 insertions(+), 5 deletions(-)

diff --git a/mt32emu/NEWS.txt b/mt32emu/NEWS.txt
index 39559bc0..50b28d14 100644
--- a/mt32emu/NEWS.txt
+++ b/mt32emu/NEWS.txt
@@ -1,3 +1,11 @@
+2026-11-02:
+
+	2.8.4 released.
+
+	* Fixed a heap buffer overflow in the MIDI stream parser that occurred when the client
+	  submitted a fragmented SysEx message with the first fragment exceeding the maximum
+	  supported size. (#149)
+
 2026-06-06:
 
 	2.8.3 released.
diff --git a/mt32emu/src/MidiStreamParser.cpp b/mt32emu/src/MidiStreamParser.cpp
index 5b5891cc..783dd764 100644
--- a/mt32emu/src/MidiStreamParser.cpp
+++ b/mt32emu/src/MidiStreamParser.cpp
@@ -129,9 +129,11 @@ void MidiStreamParserImpl::processShortMessage(const Bit32u message) {
 
 // We deal with SysEx messages below 512 bytes long in most cases. Nevertheless, it seems reasonable to support a possibility
 // to load bulk dumps using a single message. However, this is known to fail with a real device due to limited input buffer size.
+// Checks whether there is available space in the buffer, potentially reallocating it to the maximum capacity.
+// Returns true iff it's possible to add a new byte to the buffer.
 bool MidiStreamParserImpl::checkStreamBufferCapacity(const bool preserveContent) {
 	if (streamBufferSize < streamBufferCapacity) return true;
-	if (streamBufferCapacity < MAX_STREAM_BUFFER_SIZE) {
+	if (streamBufferSize < MAX_STREAM_BUFFER_SIZE && streamBufferCapacity < MAX_STREAM_BUFFER_SIZE) {
 		Bit8u *oldStreamBuffer = streamBuffer;
 		streamBufferCapacity = MAX_STREAM_BUFFER_SIZE;
 		streamBuffer = new Bit8u[streamBufferCapacity];
@@ -244,14 +246,16 @@ Bit32u MidiStreamParserImpl::parseSysex(const Bit8u stream[], const Bit32u lengt
 		}
 	}
 
-	// Store incomplete SysEx message for further processing
+	// Store incomplete SysEx message for further processing if it fits into the allowed buffer size.
 	streamBufferSize = sysexLength;
 	if (checkStreamBufferCapacity(false)) {
-		memcpy(streamBuffer, stream, sysexLength);
+		// Better be paranoid about buffer overflows.
+		Bit32u bytesToCopy = sysexLength < streamBufferCapacity ? sysexLength : streamBufferCapacity;
+		memcpy(streamBuffer, stream, bytesToCopy);
 	} else {
-		// Not enough buffer capacity, don't care about the real buffer content, just mark the first byte
+		// Not enough buffer capacity. We don't have to care about the real buffer content as the message is going to be discarded.
+		// We just mark the buffer as containing a SysEx, and streamBufferSize already indicates a buffer overrun.
 		*streamBuffer = *stream;
-		streamBufferSize = streamBufferCapacity;
 	}
 	return sysexLength;
 }
diff --git a/mt32emu/src/test/MidiStreamParserTest.cpp b/mt32emu/src/test/MidiStreamParserTest.cpp
index e10ec91d..0ae706d2 100644
--- a/mt32emu/src/test/MidiStreamParserTest.cpp
+++ b/mt32emu/src/test/MidiStreamParserTest.cpp
@@ -254,6 +254,46 @@ TEST_CASE("MidiStreamParser should ignore incomplete System Exclusive messages")
 	parser.checkRemainingEvents();
 }
 
+TEST_CASE("MidiStreamParser should handle fragmented SysEx messages of the maximum size") {
+	Bit8u *sysex = new Bit8u[MAX_STREAM_BUFFER_SIZE];
+	sysex[0] = 0xF0;
+	memset(sysex + 1, 0x3C, MAX_STREAM_BUFFER_SIZE - 2);
+	sysex[MAX_STREAM_BUFFER_SIZE - 1] = 0xF7;
+
+	const ParserEvent expected[] = { ParserEvent(sysex, MAX_STREAM_BUFFER_SIZE) };
+	TestMidiStreamParser parser(expected);
+	parser.parseStream(sysex, MAX_STREAM_BUFFER_SIZE - 1);
+	parser.parseStream(sysex + MAX_STREAM_BUFFER_SIZE - 1, 1);
+
+	parser.checkRemainingEvents();
+
+	delete[] sysex;
+}
+
+TEST_CASE("MidiStreamParser should ignore fragmented SysEx messages above the maximum size") {
+	const ParserEvent expected[] = { "streamBuffer overrun" };
+	TestMidiStreamParser parser(expected);
+
+	Bit8u *bigSysexFragment = new Bit8u[MAX_STREAM_BUFFER_SIZE + 1];
+	bigSysexFragment[0] = 0xF0;
+	memset(bigSysexFragment + 1, 0x3C, MAX_STREAM_BUFFER_SIZE);
+
+	SUBCASE("when the first fragment has the maximum size") {
+		parser.parseStream(bigSysexFragment, MAX_STREAM_BUFFER_SIZE);
+	}
+
+	SUBCASE("when the first fragment exceeds the maximum size") {
+		parser.parseStream(bigSysexFragment, MAX_STREAM_BUFFER_SIZE + 1);
+	}
+
+	const Bit8u endOfSysex = 0xF7;
+	parser.parseStream(&endOfSysex, 1);
+
+	parser.checkRemainingEvents();
+
+	delete[] bigSysexFragment;
+}
+
 } // namespace Test
 
 } // namespace MT32Emu
