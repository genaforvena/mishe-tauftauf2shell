From 3df2be4834c146bdcec90009a0f2e5771ff63cca Mon Sep 17 00:00:00 2001
From: Deus Rex research team <research@deusrex.ai>
Date: Mon, 9 Nov 2026 07:44:57 +0000
Subject: [PATCH] Fix CVE-2026-123975

globus_gss_assist: reject SSLv2 record lengths below 3 in token_get_fd

globus_gss_assist_token_get_fd() computes the body size of an SSLv2
record as the 15-bit record length minus 3. A peer that sends a record
length below 3 makes the size negative. The token buffer is then
allocated too small, and the following 5-byte memcpy and the fread of
the body write past it before any authentication. This crashes
globus-gatekeeper.

Reject a negative or oversized length with
GLOBUS_GSS_ASSIST_TOKEN_ERR_BAD_SIZE, as the raw-length branch below
already does.

Reported-by: Deus Rex research team <research@deusrex.ai>
---
 gsi/gss_assist/source/tokens_f.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/gsi/gss_assist/source/tokens_f.c b/gsi/gss_assist/source/tokens_f.c
index 5aac99dd9..078b4a56b 100644
--- a/gsi/gss_assist/source/tokens_f.c
+++ b/gsi/gss_assist/source/tokens_f.c
@@ -119,6 +119,16 @@ globus_gss_assist_token_get_fd(
              */
             dsize = ( (((unsigned int) (int_buf[0] & 0x7f)) << 8)
                     |  ((unsigned int) int_buf[1]) ) - 3;
+            /* An SSLv2 record length below 3 underflows dsize (and thus
+             * size = dsize + 5), yielding an undersized malloc that the
+             * fixed 5-byte memcpy and the (size_t)-cast fread overflow.
+             * Reject it, mirroring the lower-bound guard the raw-length
+             * branch already applies below. */
+            if (dsize < 0 || dsize > (1 << 24))
+            {
+                return_value = GLOBUS_GSS_ASSIST_TOKEN_ERR_BAD_SIZE;
+                goto exit;
+            }
         }
         else
         {
