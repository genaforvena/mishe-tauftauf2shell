diff --git a/libheif/api/libheif/heif_image.cc b/libheif/api/libheif/heif_image.cc
index 144b07c942..d61b7904bf 100644
--- a/libheif/api/libheif/heif_image.cc
+++ b/libheif/api/libheif/heif_image.cc
@@ -400,6 +400,12 @@ int heif_image_is_premultiplied_alpha(heif_image* image)
 
 heif_error heif_image_extend_padding_to_size(heif_image* image, int min_physical_width, int min_physical_height)
 {
+  if (min_physical_width < 0 || min_physical_height < 0) {
+    return Error{heif_error_Usage_error,
+                 heif_suberror_Invalid_parameter_value,
+                 "Cannot extend padding to a negative size."}.error_struct(image->image.get());
+  }
+
   Error err = image->image->extend_padding_to_size(min_physical_width, min_physical_height, false, nullptr);
   if (err) {
     return err.error_struct(image->image.get());
diff --git a/libheif/api/libheif/heif_image.h b/libheif/api/libheif/heif_image.h
index 30d6822b7f..ce2393f7bf 100644
--- a/libheif/api/libheif/heif_image.h
+++ b/libheif/api/libheif/heif_image.h
@@ -426,8 +426,9 @@ int heif_image_is_premultiplied_alpha(heif_image* image);
 // This function extends the padding of the image so that it has at least the given physical size.
 // The padding border is filled with the pixels along the right/bottom border.
 // This function may be useful if you want to process the image, but have some external padding requirements.
-// The image size will not be modified if it is already larger/equal than the given physical size.
-// I.e. you cannot assume that after calling this function, the stride will be equal to min_physical_width.
+// Each requested dimension must be at least as large as the corresponding image dimension;
+// otherwise an error is returned. The logical image size is not modified.
+// Existing padding may be larger, so the stride need not equal min_physical_width.
 LIBHEIF_API
 heif_error heif_image_extend_padding_to_size(heif_image* image,
                                              int min_physical_width, int min_physical_height);
diff --git a/libheif/image/pixelimage.cc b/libheif/image/pixelimage.cc
index 7c57a1c334..0ed8e6f2df 100644
--- a/libheif/image/pixelimage.cc
+++ b/libheif/image/pixelimage.cc
@@ -608,7 +608,15 @@ Error HeifPixelImage::ComponentStorage::alloc(uint32_t width, uint32_t height, h
 Error HeifPixelImage::extend_padding_to_size(uint32_t width, uint32_t height, bool adjust_size,
                                              const heif_security_limits* limits)
 {
-  for (auto& component : m_storage) {
+  if (width < m_width || height < m_height) {
+    return Error{heif_error_Usage_error,
+                 heif_suberror_Invalid_parameter_value,
+                 "Cannot extend padding to a size smaller than the image."};
+  }
+
+  // Check every plane before changing any of them. In particular, the new
+  // allocation must fit the old plane in both directions before it is copied.
+  for (const auto& component : m_storage) {
     // get_subsampled_size() only adjusts the size for Cb/Cr; for every other
     // channel it assumes the component has the full logical image size. We
     // cannot compute a correct padded size for a non-Cb/Cr component that does
@@ -622,6 +630,19 @@ Error HeifPixelImage::extend_padding_to_size(uint32_t width, uint32_t height, bo
                    "Cannot extend padding for an image with non-uniform component sizes."};
     }
 
+    uint32_t subsampled_width, subsampled_height;
+    get_subsampled_size(width, height, component.m_channel, m_chroma,
+                        &subsampled_width, &subsampled_height);
+
+    if (subsampled_width < component.m_width ||
+        subsampled_height < component.m_height) {
+      return Error{heif_error_Usage_error,
+                   heif_suberror_Invalid_parameter_value,
+                   "Cannot extend padding to a size smaller than an existing plane."};
+    }
+  }
+
+  for (auto& component : m_storage) {
     uint32_t subsampled_width, subsampled_height;
     get_subsampled_size(width, height, component.m_channel, m_chroma,
                         &subsampled_width, &subsampled_height);
@@ -663,6 +684,10 @@ Error HeifPixelImage::extend_padding_to_size(uint32_t width, uint32_t height, bo
       std::free(component.allocated_mem);
 
       component = newPlane;
+      // alloc() set the logical plane size to the allocation size. Growing
+      // padding alone must not change the plane's visible dimensions.
+      component.m_width = old_width;
+      component.m_height = old_height;
     }
 
     // extend plane size
diff --git a/libheif/plugins/encoder_aom.cc b/libheif/plugins/encoder_aom.cc
index d891a353a6..5a5eae3ab7 100644
--- a/libheif/plugins/encoder_aom.cc
+++ b/libheif/plugins/encoder_aom.cc
@@ -100,6 +100,8 @@ struct encoder_struct_aom
 
   // bit depth the codec was initialized with, to check the later frames of a sequence against
   int bit_depth = 8;
+  int input_width = 0;
+  int input_height = 0;
 
   // --- input
 
@@ -936,6 +938,8 @@ static heif_error aom_start_sequence_encoding_intern(void* encoder_raw, const he
 
   const int source_width = heif_image_get_width(image, heif_channel_Y);
   const int source_height = heif_image_get_height(image, heif_channel_Y);
+  encoder->input_width = source_width;
+  encoder->input_height = source_height;
 
   const heif_chroma chroma = heif_image_get_chroma_format(image);
 
@@ -1285,6 +1289,13 @@ static heif_error aom_encode_sequence_frame(void* encoder_raw, const heif_image*
     return input_error;
   }
 
+  // libaom can change resolution after reconfiguring the encoder. This plugin
+  // does not do that yet; lift this check when we support mixed-size sequences.
+  input_error = check_sequence_frame_size(image, encoder->input_width, encoder->input_height);
+  if (input_error.code != heif_error_Ok) {
+    return input_error;
+  }
+
   heif_error err;
 
   const int source_width = heif_image_get_width(image, heif_channel_Y);
diff --git a/libheif/plugins/encoder_input_check.h b/libheif/plugins/encoder_input_check.h
index 127fd7621a..71278f0748 100644
--- a/libheif/plugins/encoder_input_check.h
+++ b/libheif/plugins/encoder_input_check.h
@@ -160,4 +160,21 @@ static inline heif_error check_sequence_frame_bit_depth(const heif_image* image,
   return heif_error_ok;
 }
 
+
+// These plugins open one encoder instance with dimensions taken from the first
+// frame. Reject later frames of a different size before handing their planes
+// to an encoder configured for the old size.
+static inline heif_error check_sequence_frame_size(const heif_image* image,
+                                                   int configured_width, int configured_height)
+{
+  if (heif_image_get_width(image, heif_channel_Y) != configured_width ||
+      heif_image_get_height(image, heif_channel_Y) != configured_height) {
+    return heif_error{heif_error_Invalid_input,
+                      heif_suberror_Unspecified,
+                      "All frames of a sequence must have the size of the first frame"};
+  }
+
+  return heif_error_ok;
+}
+
 #endif // LIBHEIF_ENCODER_INPUT_CHECK_H
