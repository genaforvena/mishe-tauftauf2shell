From e8f0481b383f631c375ec245e66c855c3bc22c71 Mon Sep 17 00:00:00 2001
From: Kazuho Oku <kazuhooku@gmail.com>
Date: Mon, 29 Jun 2026 16:45:09 +0900
Subject: [PATCH 1/3] add missing allocations

---
 lib/core/logconf.c | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/lib/core/logconf.c b/lib/core/logconf.c
index 5dd3de08bc..d7e3a3814d 100644
--- a/lib/core/logconf.c
+++ b/lib/core/logconf.c
@@ -652,6 +652,8 @@ char *h2o_log_request(h2o_logconf_t *logconf, h2o_req_t *req, size_t *len, char
                 size_t len = req->input.path.len - req->input.query_at;
                 RESERVE(len * unsafe_factor);
                 pos = append_unsafe_string(pos, req->input.path.base + req->input.query_at, len);
+            } else {
+                RESERVE(0);
             }
             break;
         case ELEMENT_TYPE_REQUEST_LINE: /* %r */
@@ -837,6 +839,7 @@ char *h2o_log_request(h2o_logconf_t *logconf, h2o_req_t *req, size_t *len, char
             break;
 
         case ELEMENT_TYPE_ERROR:
+            RESERVE(req->error_logs != NULL ? req->error_logs->size * unsafe_factor : 0);
             if (req->error_logs != NULL)
                 pos = append_unsafe_string(pos, req->error_logs->bytes, req->error_logs->size);
             break;

From f45ba5cf842b23a8b3d3745dca5a79949e3f5625 Mon Sep 17 00:00:00 2001
From: Kazuho Oku <kazuhooku@gmail.com>
Date: Mon, 29 Jun 2026 16:46:23 +0900
Subject: [PATCH 2/3] die when detecting inconsistency, even if NDEBUG is set

---
 lib/core/logconf.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/lib/core/logconf.c b/lib/core/logconf.c
index d7e3a3814d..3da45cee78 100644
--- a/lib/core/logconf.c
+++ b/lib/core/logconf.c
@@ -945,7 +945,7 @@ char *h2o_log_request(h2o_logconf_t *logconf, h2o_req_t *req, size_t *len, char
             break;
 
         default:
-            assert(!"unknown type");
+            h2o_fatal("unknown log element of type:%u", element->type);
             break;
         }
 

From 10d23b9529bd870acb828b6e1de5d8b7de87fcc0 Mon Sep 17 00:00:00 2001
From: Kazuho Oku <kazuhooku@gmail.com>
Date: Thu, 22 Oct 2026 16:55:25 +0900
Subject: [PATCH 3/3] logconf: reserve room for sprintf terminators

---
 lib/core/logconf.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/lib/core/logconf.c b/lib/core/logconf.c
index 3da45cee78..63e3581ec5 100644
--- a/lib/core/logconf.c
+++ b/lib/core/logconf.c
@@ -583,13 +583,14 @@ char *h2o_log_request(h2o_logconf_t *logconf, h2o_req_t *req, size_t *len, char
     for (element_index = 0; element_index != logconf->elements.size; ++element_index) {
         struct log_element_t *element = logconf->elements.entries + element_index;
 
-/* reserve capacity + suffix.len */
+/* reserve capacity + suffix.len or the NUL character */
 #define RESERVE(capacity)                                                                                                          \
     do {                                                                                                                           \
-        if ((capacity) + element->suffix.len > line_end - pos) {                                                                   \
+        size_t required = (capacity) + (element->suffix.len < 1 ? 1 : element->suffix.len);                                        \
+        if (required > line_end - pos) {                                                                                           \
             size_t off = pos - line;                                                                                               \
             size_t size = line_end - line;                                                                                         \
-            line = expand_line_buf(line, &size, off + (capacity) + element->suffix.len, should_realloc_on_expand);                 \
+            line = expand_line_buf(line, &size, off + required, should_realloc_on_expand);                                         \
             pos = line + off;                                                                                                      \
             line_end = line + size;                                                                                                \
             should_realloc_on_expand = 1;                                                                                          \
