From 714067b0134cf36f89464dbc6ec25529c0e189c7 Mon Sep 17 00:00:00 2001
From: Sebastian Schildt <sebastian.schildt@hs-heilbronn.de>
Date: Fri, 30 Oct 2026 10:33:34 +0100
Subject: [PATCH] Fix OOB read and wraparound in VSS path handling

Signed-off-by: Sebastian Schildt <sebastian.schildt@hs-heilbronn.de>
---
 docs/api-design.md            |   6 +-
 include/avtp/acf/custom/Vss.h |  28 ++++++++
 src/avtp/acf/custom/Vss.c     |  69 ++++++++++++++-----
 unit/test-vss.c               | 120 +++++++++++++++++++++++++++++++---
 4 files changed, 196 insertions(+), 27 deletions(-)

diff --git a/docs/api-design.md b/docs/api-design.md
index b77732e..26527ad 100644
--- a/docs/api-design.md
+++ b/docs/api-design.md
@@ -884,8 +884,10 @@ For VSS:
 - VSS accessors therefore remain self-checking: reads are clamped against the
   *declared* message length, and truncated or internally inconsistent fields
   (e.g. a path or data length prefix that exceeds the declared message)
-  no-op or return conservative values instead of trusting the wire data. The
-  remaining validation lives in the getters, not in `IsValid`.
+  no-op or return conservative values instead of trusting the wire data.
+  `Avtp_Vss_CalcVssPathLength()` reports 0 for a truncated or inconsistent
+  path instead of wrapping or reading past the declared frame. The remaining
+  validation lives in the getters, not in `IsValid`.
 - Because of that complexity, VSS accessors are implemented in the `.c` file
   (non-inline) rather than as inline header functions.
 
diff --git a/include/avtp/acf/custom/Vss.h b/include/avtp/acf/custom/Vss.h
index 71a5a53..fe93acb 100644
--- a/include/avtp/acf/custom/Vss.h
+++ b/include/avtp/acf/custom/Vss.h
@@ -310,6 +310,23 @@ void Avtp_Vss_GetVssPath(const Avtp_Vss_t *const pdu, VssPath_t *val);
  */
 void Avtp_Vss_GetVssData(const Avtp_Vss_t *const pdu, VssData_t *val);
 uint16_t Avtp_Vss_GetVSSDataStringArrayLength(const VssDataStringArray_t *str_array);
+
+/**
+ * Returns the total length of the VSS path in bytes, including the 2-byte
+ * length prefix used in VSS_INTEROP_MODE.
+ *
+ * The result is 0 when the PDU has no valid path: an unknown addressing mode,
+ * a path prefix that does not fit the declared ACF message length, or a total
+ * length that cannot be represented in uint16_t.
+ *
+ * For an unframed PDU (ACF message length 0) the on-wire path prefix is used
+ * without clamping to the declared length, so this function can be used while
+ * building a frame with Avtp_Vss_SetVssPath(), Avtp_Vss_SetVssData() and
+ * Avtp_Vss_SetPayloadLength() in that order.
+ *
+ * @param pdu Pointer to the first bit of an 1722 ACF VSS PDU.
+ * @returns Path length in bytes, or 0 if no valid path is present.
+ */
 uint16_t Avtp_Vss_CalcVssPathLength(const Avtp_Vss_t *const pdu);
 void Avtp_Vss_DeserializeStringArray(const VssDataStringArray_t *const vss_data_string_array,
                                      VssDataString_t *strings[], uint16_t num_strings);
@@ -320,6 +337,17 @@ void Avtp_Vss_SetOpCode(Avtp_Vss_t *pdu, Vss_OpCode_t val);
 void Avtp_Vss_SetDatatype(Avtp_Vss_t *pdu, Vss_Datatype_t val);
 void Avtp_Vss_SetMessageTimestamp(Avtp_Vss_t *pdu, uint64_t val);
 void Avtp_Vss_SetVssPath(Avtp_Vss_t *pdu, VssPath_t *val);
+
+/**
+ * Serializes VSS data into an ACF VSS PDU after the VSS path.
+ *
+ * The caller must provide a buffer large enough for the fixed header, path and
+ * data. If the PDU has no valid path (for example a truncated frame or an
+ * unrepresentable path length), this function does nothing.
+ *
+ * @param pdu Pointer to the first bit of an 1722 ACF VSS PDU.
+ * @param val Pointer to the VSS data union to serialize.
+ */
 void Avtp_Vss_SetVssData(Avtp_Vss_t *pdu, VssData_t *val);
 void Avtp_Vss_SerializeStringArray(VssDataStringArray_t *vss_data_string_array,
                                    VssDataString_t *strings[], uint16_t num_strings);
diff --git a/src/avtp/acf/custom/Vss.c b/src/avtp/acf/custom/Vss.c
index 49d24db..497c41c 100644
--- a/src/avtp/acf/custom/Vss.c
+++ b/src/avtp/acf/custom/Vss.c
@@ -101,8 +101,7 @@ static void vss_store_be64(uint8_t *ptr, uint64_t value)
 
 /* Read a 16‑bit big‑endian length prefix at *ptr and clamp it so that
  * ptr + 2 + length does not exceed the declared PDU size (msg_length in
- * quadlets × 4).  When msg_length is 0 (PDU not framed yet) the wire
- * length is returned unchanged.
+ * quadlets × 4).  A prefix that does not fit the declared PDU yields 0.
  *
  * The prefix is only dereferenced when offset + 2 ≤ declared so that an
  * out‑of‑frame data pointer never produces an OOB read before clamping.
@@ -133,9 +132,9 @@ static uint16_t vss_read_clamped_length(const Avtp_Vss_t *pdu, const uint8_t *pt
 
 /* Getter‑side path length in bytes, clamped so that
  * AVTP_VSS_FIXED_HEADER_LEN + path_length ≤ declared PDU size.
- * Setters use CalcVssPathLength (raw) instead; this helper is for the
- * read path only so that the data‑pointer computation never leaves the
- * frame.  */
+ * Setters use CalcVssPathLength instead, which preserves the unframed
+ * construction case; this helper is for the read path only so that the
+ * data‑pointer computation never leaves the frame. */
 static uint16_t vss_get_clamped_path_length(const Avtp_Vss_t *pdu)
 {
     uint16_t declared = Avtp_AcfCommon_GetAcfMsgLengthInBytes((const Avtp_AcfCommon_t *)pdu);
@@ -294,19 +293,52 @@ void Avtp_Vss_GetVssPath(const Avtp_Vss_t *const pdu, VssPath_t *val)
 
 uint16_t Avtp_Vss_CalcVssPathLength(const Avtp_Vss_t *const pdu)
 {
+    if (pdu == NULL) {
+        return 0;
+    }
 
-    const uint8_t *vss_path_ptr = (const uint8_t *const)pdu + AVTP_VSS_FIXED_HEADER_LEN;
-
-    // Check the used VSS addressing mode
     Vss_AddrMode_t addr_mode = Avtp_Vss_GetAddrMode(pdu);
-    uint16_t path_length = 0;
+    uint16_t declared = Avtp_AcfCommon_GetAcfMsgLengthInBytes((const Avtp_AcfCommon_t *)pdu);
+    const uint8_t *vss_path_ptr = (const uint8_t *)pdu + AVTP_VSS_FIXED_HEADER_LEN;
+
+    if (declared != 0) {
+        if (declared < AVTP_VSS_FIXED_HEADER_LEN) {
+            return 0;
+        }
+
+        uint32_t available = (uint32_t)declared - (uint32_t)AVTP_VSS_FIXED_HEADER_LEN;
+
+        if (addr_mode == VSS_STATIC_ID_MODE) {
+            return (available >= 4U) ? 4 : 0;
+        }
+
+        if (addr_mode != VSS_INTEROP_MODE || available < 2U) {
+            return 0;
+        }
+
+        uint32_t total_length = (uint32_t)vss_load_be16(vss_path_ptr) + 2U;
+        if (total_length > available) {
+            return 0;
+        }
+        return (uint16_t)total_length;
+    }
 
+    /* The ACF length is set last when building a frame, so an unframed PDU
+     * must use the on‑wire path prefix without clamping it to the declared
+     * length. */
     if (addr_mode == VSS_STATIC_ID_MODE) {
-        path_length = 4;
-    } else if (addr_mode == VSS_INTEROP_MODE) {
-        path_length = vss_load_be16(vss_path_ptr) + 2;
+        return 4;
     }
-    return path_length;
+
+    if (addr_mode != VSS_INTEROP_MODE) {
+        return 0;
+    }
+
+    uint32_t total_length = (uint32_t)vss_load_be16(vss_path_ptr) + 2U;
+    if (total_length > UINT16_MAX) {
+        return 0;
+    }
+    return (uint16_t)total_length;
 }
 
 uint16_t Avtp_Vss_GetVSSDataStringArrayLength(const VssDataStringArray_t *const str_array)
@@ -619,9 +651,16 @@ void Avtp_Vss_SetVssPath(Avtp_Vss_t *pdu, VssPath_t *val)
 void Avtp_Vss_SetVssData(Avtp_Vss_t *pdu, VssData_t *val)
 {
 
+    uint16_t vss_path_length = Avtp_Vss_CalcVssPathLength(pdu);
+
+    /* No valid path (truncated, inconsistent, or reserved addressing mode):
+     * do not overwrite the path area with payload data. */
+    if (vss_path_length == 0) {
+        return;
+    }
+
     // Get a pointer to the start of the VSS data
-    uint8_t *vss_data_ptr =
-        (uint8_t *)pdu + AVTP_VSS_FIXED_HEADER_LEN + Avtp_Vss_CalcVssPathLength(pdu);
+    uint8_t *vss_data_ptr = (uint8_t *)pdu + AVTP_VSS_FIXED_HEADER_LEN + vss_path_length;
     Vss_Datatype_t datatype = Avtp_Vss_GetDatatype(pdu);
 
     uint32_t temp_float;
diff --git a/unit/test-vss.c b/unit/test-vss.c
index 85f5993..45403a5 100644
--- a/unit/test-vss.c
+++ b/unit/test-vss.c
@@ -40,6 +40,7 @@ extern "C" {
 #include <arpa/inet.h>
 #include <errno.h>
 #include <string.h>
+#include <stdlib.h>
 #include <math.h>
 #include <stdio.h>
 
@@ -486,7 +487,7 @@ static void vss_data_string(void **state)
     char str_value_recv[vss_data_get.data_string->data_length];
     vss_data_string_get.data = str_value_recv;
     Avtp_Vss_GetVssData(vss_pdu, &vss_data_get);
-    assert_string_equal(vss_data_get.data_string->data, str_value);
+    assert_memory_equal(vss_data_get.data_string->data, str_value, strlen(str_value));
 }
 
 static void vss_data_uint8_array(void **state)
@@ -999,7 +1000,8 @@ static void vss_data_string_array(void **state)
     vss_str3.data_length = strlen(str3);
 
     VssDataString_t *arr[] = {&vss_str1, &vss_str2, &vss_str3};
-    uint8_t buffer[strlen(str1) + strlen(str2) + strlen(str3) + 2];
+    /* Each string entry is prefixed by a 2-byte length field. */
+    uint8_t buffer[strlen(str1) + strlen(str2) + strlen(str3) + 2 * 3];
     VssDataStringArray_t vss_str_array = {0};
     vss_str_array.data = buffer;
     Avtp_Vss_SerializeStringArray(&vss_str_array, arr, 3);
@@ -1168,11 +1170,104 @@ static void vss_path_interop_oob(void **state)
     assert_int_equal(get_path.vss_interop_path.path_length, 6);
     assert_memory_equal(path_buf, "AB\0\0\0\0", 6);
 
-    /* CalcVssPathLength returns the raw wire value (0xFFFF + 2 = 1 in
-     * uint16_t arithmetic).  It is intentionally not clamped — setters
-     * (SetVssPath, SetVssData, Pad) use it and need the real on‑wire
-     * length.  Only the getters apply vss_read_clamped_length. */
-    assert_int_equal(Avtp_Vss_CalcVssPathLength(pdu), 1);
+    /* The wire prefix 0xFFFF does not fit the declared frame, so there is
+     * no valid path length to report.  CalcVssPathLength must not wrap to
+     * 1 or read beyond the declared message. */
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(pdu), 0);
+}
+
+static void vss_calc_path_length_header_only(void **state)
+{
+    (void)state;
+
+    /* INTEROP: a header-only frame passes IsValid, but there is no room for
+     * the 2-byte path prefix.  Heap allocation makes a stale prefixed read
+     * visible under ASan. */
+    uint8_t *interop = (uint8_t *)malloc(AVTP_VSS_FIXED_HEADER_LEN);
+    assert_non_null(interop);
+
+    Avtp_Vss_Init((Avtp_Vss_t *)interop);
+    Avtp_Vss_SetAddrMode((Avtp_Vss_t *)interop, VSS_INTEROP_MODE);
+    Avtp_AcfCommon_SetAcfMsgLength((Avtp_AcfCommon_t *)interop,
+                                   AVTP_VSS_FIXED_HEADER_LEN / AVTP_QUADLET_SIZE);
+    assert_true(Avtp_Vss_IsValid((Avtp_Vss_t *)interop, AVTP_VSS_FIXED_HEADER_LEN));
+    assert_int_equal(Avtp_Vss_CalcVssPathLength((Avtp_Vss_t *)interop), 0);
+    free(interop);
+
+    /* STATIC_ID: same header-only frame has no room for the 4-byte ID. */
+    uint8_t *static_id = (uint8_t *)malloc(AVTP_VSS_FIXED_HEADER_LEN);
+    assert_non_null(static_id);
+
+    Avtp_Vss_Init((Avtp_Vss_t *)static_id);
+    Avtp_Vss_SetAddrMode((Avtp_Vss_t *)static_id, VSS_STATIC_ID_MODE);
+    Avtp_AcfCommon_SetAcfMsgLength((Avtp_AcfCommon_t *)static_id,
+                                   AVTP_VSS_FIXED_HEADER_LEN / AVTP_QUADLET_SIZE);
+    assert_true(Avtp_Vss_IsValid((Avtp_Vss_t *)static_id, AVTP_VSS_FIXED_HEADER_LEN));
+    assert_int_equal(Avtp_Vss_CalcVssPathLength((Avtp_Vss_t *)static_id), 0);
+    free(static_id);
+}
+
+static void vss_calc_path_length_unframed(void **state)
+{
+    (void)state;
+
+    uint8_t pdu[MAX_PDU_SIZE];
+    Avtp_Vss_t *vss_pdu = (Avtp_Vss_t *)pdu;
+    memset(pdu, 0, sizeof(pdu));
+    Avtp_Vss_Init(vss_pdu);
+
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(NULL), 0);
+
+    /* Default mode is INTEROP.  A prefix of 13 gives 15 bytes including the
+     * 2-byte prefix. */
+    pdu[AVTP_VSS_FIXED_HEADER_LEN] = 0x00;
+    pdu[AVTP_VSS_FIXED_HEADER_LEN + 1] = 0x0D;
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(vss_pdu), 15);
+
+    /* Totals that do not fit uint16_t must not wrap. */
+    pdu[AVTP_VSS_FIXED_HEADER_LEN] = 0xFF;
+    pdu[AVTP_VSS_FIXED_HEADER_LEN + 1] = 0xFE;
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(vss_pdu), 0);
+
+    pdu[AVTP_VSS_FIXED_HEADER_LEN + 1] = 0xFF;
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(vss_pdu), 0);
+
+    /* STATIC_ID is a fixed 4-byte path, even before the frame is finalized. */
+    Avtp_Vss_SetAddrMode(vss_pdu, VSS_STATIC_ID_MODE);
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(vss_pdu), 4);
+
+    /* Reserved addressing modes have no defined path layout. */
+    Avtp_Vss_SetAddrMode(vss_pdu, (Vss_AddrMode_t)2);
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(vss_pdu), 0);
+}
+
+static void vss_set_data_malformed_path_no_write(void **state)
+{
+    (void)state;
+
+    uint8_t pdu[20];
+    uint8_t expected[8];
+    Avtp_Vss_t *vss_pdu = (Avtp_Vss_t *)pdu;
+
+    memset(pdu, 0, sizeof(pdu));
+    memset(expected, 0x5A, sizeof(expected));
+    expected[0] = 0xFF;
+    expected[1] = 0xFF;
+    memcpy(pdu + AVTP_VSS_FIXED_HEADER_LEN, expected, sizeof(expected));
+
+    Avtp_Vss_Init(vss_pdu);
+    Avtp_Vss_SetAddrMode(vss_pdu, VSS_INTEROP_MODE);
+    Avtp_Vss_SetDatatype(vss_pdu, VSS_UINT16);
+    Avtp_AcfCommon_SetAcfMsgLength((Avtp_AcfCommon_t *)vss_pdu, 5); /* 20 bytes */
+
+    VssData_t data;
+    memset(&data, 0, sizeof(data));
+    data.data_uint16 = 0xBEEF;
+    Avtp_Vss_SetVssData(vss_pdu, &data);
+
+    /* The malformed 0xFFFF prefix describes no valid path, so SetVssData
+     * must leave the path area untouched. */
+    assert_memory_equal(pdu + AVTP_VSS_FIXED_HEADER_LEN, expected, sizeof(expected));
 }
 
 /* ── Avtp_Vss_GetVssData  –  memcpy group (wire length→memcpy) ──────── */
@@ -1494,9 +1589,8 @@ static void vss_data_double_array_oob(void **state)
 
 /* Helper for the inflated-path tests: build an INTEROP-mode PDU where the
  * on‑wire path_length (0xFFFD) claims far more path bytes than the declared
- * msg_length allows.  CalcVssPathLength would return 0xFFFD + 2 = 0xFFFF
- * (65535 — no uint16_t wrap), pushing the computed data pointer 65547 bytes
- * past the PDU start — well beyond any plausible frame. */
+ * msg_length allows.  CalcVssPathLength reports 0 because the path does not
+ * fit the declared frame; the getters clamp the path instead. */
 static Avtp_Vss_t *vss_build_inflated_path_pdu(uint8_t *buf, size_t buf_size, uint8_t msg_quadlets,
                                                Vss_Datatype_t datatype)
 {
@@ -1728,6 +1822,9 @@ static void vss_is_valid_header_only_frame(void **state)
     /* Smallest frame that still passes: declared == buffer == header. */
     assert_true(Avtp_Vss_IsValid(pdu, sizeof(buf)));
     assert_false(Avtp_Vss_IsValid(pdu, sizeof(buf) - 1));
+
+    /* There is no room for a path prefix or static ID in this frame. */
+    assert_int_equal(Avtp_Vss_CalcVssPathLength(pdu), 0);
 }
 
 /* A valid full frame (talker-built, interop path + float data) must pass
@@ -1781,6 +1878,8 @@ int main(void)
         cmocka_unit_test(vss_is_valid_declared_larger_than_buffer),
         cmocka_unit_test(vss_is_valid_declared_smaller_than_header),
         cmocka_unit_test(vss_is_valid_header_only_frame),
+        cmocka_unit_test(vss_calc_path_length_header_only),
+        cmocka_unit_test(vss_calc_path_length_unframed),
         cmocka_unit_test(vss_is_valid_roundtrip),
         cmocka_unit_test(vss_static_path),
         cmocka_unit_test(vss_interop_path),
@@ -1810,6 +1909,7 @@ int main(void)
         cmocka_unit_test(vss_data_string_array),
         cmocka_unit_test(vss_data_string_array_malformed),
         cmocka_unit_test(vss_path_interop_oob),
+        cmocka_unit_test(vss_set_data_malformed_path_no_write),
         cmocka_unit_test(vss_data_string_oob),
         cmocka_unit_test(vss_data_uint8_array_oob),
         cmocka_unit_test(vss_data_int8_array_oob),
