From 21261436492f0014930e804e20586e3833bb91b9 Mon Sep 17 00:00:00 2001
From: kaelyn ke <313807495+kaelynkk@users.noreply.github.com>
Date: Fri, 25 Sep 2026 01:21:19 +0800
Subject: [PATCH] ims_registrar_pcscf: check for port size in alias param

process_contact() in notify.c parses the alias=<host>~<port>~<proto>
NAT parameter and copies the port field into a 5 bytes stack buffer
without checking the length, allowing a stack buffer overflow up to
MAX_URI_SIZE bytes. Even a 5 digits port (65535) writes one byte past
the end since the buffer needs 6 bytes for 5 digits plus the null
terminator.

The same parser exists in save.c (update_contacts()), where portbuf[5]
is filled with memcpy() and no length check.

Apply the same fix as the upstream commit 57794cd142 for the sibling
module ims_ipsec_pcscf: enlarge the buffer to 6 bytes and reject a
port longer than 5 digits.

Fixes #4954
---
 src/modules/ims_registrar_pcscf/notify.c |  7 ++++++-
 src/modules/ims_registrar_pcscf/save.c   | 10 +++++++---
 2 files changed, 13 insertions(+), 4 deletions(-)

diff --git a/src/modules/ims_registrar_pcscf/notify.c b/src/modules/ims_registrar_pcscf/notify.c
index d068a5705c7..9abc27a60f6 100644
--- a/src/modules/ims_registrar_pcscf/notify.c
+++ b/src/modules/ims_registrar_pcscf/notify.c
@@ -88,7 +88,7 @@ extern ims_registrar_pcscf_params_t _imsregp_params;
 int process_contact(
 		udomain_t *_d, int expires, str contact_uri, int contact_state)
 {
-	char bufport[5], *rest, *sep, *val, *port, *trans;
+	char bufport[6], *rest, *sep, *val, *port, *trans;
 	pcontact_t *pcontact;
 	struct pcontact_info ci;
 	struct sip_uri puri, uri;
@@ -171,6 +171,11 @@ int process_contact(
 		}
 
 		received_port_len = trans - port;
+		if(received_port_len >= sizeof(bufport)) {
+			LM_ERR("invalid port value\n");
+			ret = RESULT_ERROR;
+			goto done;
+		}
 
 		trans = trans + 1;
 		received_proto = *trans - 48 /* char 0 */;
diff --git a/src/modules/ims_registrar_pcscf/save.c b/src/modules/ims_registrar_pcscf/save.c
index 87285b3cb9f..6e697c03b90 100644
--- a/src/modules/ims_registrar_pcscf/save.c
+++ b/src/modules/ims_registrar_pcscf/save.c
@@ -133,7 +133,7 @@ static inline int update_contacts(struct sip_msg *req, struct sip_msg *rpl,
 	pcontact_t *pcontact;
 	unsigned short port, proto;
 	char *alias_start, *p, *port_s, *proto_s;
-	char portbuf[5];
+	char portbuf[6];
 	str alias_s;
 	char srcip[50];
 
@@ -225,13 +225,17 @@ static inline int update_contacts(struct sip_msg *req, struct sip_msg *rpl,
 						if(p != NULL) {
 							LM_DBG("alias(port) [%.*s]\n", (int)(p - port_s),
 									port_s);
-							memset(portbuf, 0, 5);
+							if((p - port_s) > 5) {
+								LM_ERR("invalid port value\n");
+								return -1;
+							}
+							memset(portbuf, 0, 6);
 							memcpy(portbuf, port_s, (p - port_s));
 							port = atoi(portbuf);
 							LM_DBG("alias(port) [%d]\n", port);
 
 							proto_s = p + 1;
-							memset(portbuf, 0, 5);
+							memset(portbuf, 0, 6);
 							memcpy(portbuf, proto_s, 1);
 							proto = atoi(portbuf);
 							LM_DBG("alias(proto) [%d]\n", proto);
