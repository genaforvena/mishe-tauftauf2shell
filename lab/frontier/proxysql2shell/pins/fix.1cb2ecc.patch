From 1cb2ecc17a0206bc2bed9090d5d7fab121f2798e Mon Sep 17 00:00:00 2001
From: Rene Cannao <rene@proxysql.com>
Date: Thu, 14 May 2026 08:56:43 +0000
Subject: [PATCH] fix(security): bound first-packet recv() in MySQL and PgSQL
 data streams (GHSA-58ww-865x-grpr)

An unauthenticated client could declare an oversized first-packet length
in either protocol and ProxySQL would pass that length straight to recv()
while writing into the fixed 32 KB queueIN buffer, producing an
out-of-bounds heap write in:
  - MySQL_Data_Stream::read_from_net (lib/mysql_data_stream.cpp)
  - PgSQL_Data_Stream::read_from_net (lib/PgSQL_Data_Stream.cpp)

The pre-existing PROXY-protocol prefix check only handled the 'PROX'
literal variant from sysown/proxysql#5376; the general ordinary
first-packet path was still vulnerable.

Bound the second recv() against the remaining queueIN capacity and
shut_soft() the connection when the declared length exceeds the bound.
For MySQL that bound is queue_available - 4 (header size); for PgSQL it
is queue_available - 5 (type byte + 4-byte length).

Add a TAP regression test that opens raw sockets to both listeners,
sends oversized first-packet headers with declared lengths above the
queue boundary (32765, 65535, 100000, protocol-max), and asserts:
  - the listener closes the connection promptly
  - ProxySQL admin remains responsive afterward (no daemon crash)

Run under ASAN to catch any future regression of the bounds check.
---
 lib/PgSQL_Data_Stream.cpp                     |  13 +-
 lib/mysql_data_stream.cpp                     |  10 +
 test/tap/groups/groups.json                   |   1 +
 .../tests/reg_test_oversize_first_pkt-t.cpp   | 178 ++++++++++++++++++
 4 files changed, 201 insertions(+), 1 deletion(-)
 create mode 100644 test/tap/tests/reg_test_oversize_first_pkt-t.cpp

diff --git a/lib/PgSQL_Data_Stream.cpp b/lib/PgSQL_Data_Stream.cpp
index f5a9e0fc64..de2435692e 100644
--- a/lib/PgSQL_Data_Stream.cpp
+++ b/lib/PgSQL_Data_Stream.cpp
@@ -530,7 +530,18 @@ int PgSQL_Data_Stream::read_from_net() {
 					c = buff[read_pos++];
 					d = buff[read_pos++];
 					length = (a << 24) | (b << 16) | (c << 8) | d;
-					
+
+					// GHSA-58ww-865x-grpr: bound the declared packet length by the
+					// remaining capacity of queueIN. Without this check an unauthenticated
+					// client can drive a heap out-of-bounds write into the fixed-size
+					// 32KB input queue by sending an oversized first PostgreSQL packet.
+					if (length > (uint32_t)(s - 5)) {
+						proxy_error("Oversized first packet from PgSQL client: length=%u exceeds queue capacity (%d). Closing fd=%d\n",
+							length, s - 5, fd);
+						shut_soft();
+						return -1;
+					}
+
 					r += recv(fd, queue_w_ptr(queueIN) + 5, length, 0);
 				}
 			}
diff --git a/lib/mysql_data_stream.cpp b/lib/mysql_data_stream.cpp
index fcdbfed6b6..4f0845eec5 100644
--- a/lib/mysql_data_stream.cpp
+++ b/lib/mysql_data_stream.cpp
@@ -662,6 +662,16 @@ int MySQL_Data_Stream::read_from_net() {
 						// let's try to read a whole packet
 						mysql_hdr Hdr;
 						memcpy(&Hdr,queueIN.buffer,sizeof(mysql_hdr));
+						// GHSA-58ww-865x-grpr: bound the declared packet length by the
+						// remaining capacity of queueIN. Without this check an unauthenticated
+						// client can drive a heap out-of-bounds write into the fixed-size
+						// 32KB input queue by sending an oversized first MySQL packet.
+						if (Hdr.pkt_length > (unsigned int)(s - 4)) {
+							proxy_error("Oversized first packet from client: pkt_length=%u exceeds queue capacity (%d). Closing fd=%d\n",
+								Hdr.pkt_length, s - 4, fd);
+							shut_soft();
+							return -1;
+						}
 						r += recv(fd, queue_w_ptr(queueIN)+4, Hdr.pkt_length, 0);
 					}
 				}
