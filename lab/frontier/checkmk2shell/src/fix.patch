index 00000000000..9e1d1534644
--- /dev/null
+++ b/.werks/22918.md
@@ -0,0 +1,41 @@
+[//]: # (werk v3)
+# Fix stack buffer overflow in mkevent
+
+key        | value
+---------- | ---
+date       | 2026-10-30T16:38:45.877000+00:00
+version    | 3.0.0b1
+class      | security
+edition    | community
+component  | ec
+level      | 1
+compatible | yes
+
+mkevent built the notifications it forwards to the Event Console in an 8 KB
+stack buffer without checking their length. A long host or service output could
+crash it, lose the notification or, if crafted, redirect it to an IPv4 address
+of the attacker's choice. mkevent now cuts messages off after 8191 bytes.
+
+*Who's Affected*:
+
+All editions, but only sites forwarding notifications to the Event Console with
+the notification plug-in "Forward notification to Event Console" or the global
+setting "Send notifications to Event Console".
+
+*Affected Versions*:
+
+* 2.5.0
+* 2.4.0
+* 2.3.0 (EOL)
+* 2.2.0 (EOL)
+
+*Mitigations*:
+
+If updating is not possible, disable the notification rules and unset the
+global setting mentioned above.
+
+*Vulnerability Management*:
+
+We have rated the issue with a CVSS Score of 2.3 Low
+(`CVSS:4.0/AV:N/AC:L/AT:P/PR:L/UI:N/VC:L/VI:L/VA:L/SC:N/SI:L/SA:N`) and assigned
+`CVE-2026-110470`.
diff --git a/packages/cmk-ec/src/mkevent.cc b/packages/cmk-ec/src/mkevent.cc
index 288bf8e3aeb..17ff9afdf36 100644
--- a/packages/cmk-ec/src/mkevent.cc
+++ b/packages/cmk-ec/src/mkevent.cc
@@ -16,7 +16,6 @@
 #include <chrono>
 #include <csignal>
 #include <cstdlib>
-#include <cstring>
 #include <ctime>
 #include <iostream>
 #include <memory>
@@ -41,23 +40,27 @@ enum class ExitCode {
     permanent_error = 2,
 };
 
-// NOLINTBEGIN(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay,cppcoreguidelines-pro-bounds-constant-array-index,cppcoreguidelines-pro-bounds-pointer-arithmetic,misc-const-correctness)
-char *append_str(std::string_view str, char *dest) {
-    memcpy(dest, str.data(), str.size());
-    return dest + str.size();
+// Like with the old message buffer of 8192 bytes, including the NUL
+constexpr std::string::size_type max_message_length = 8191;
+
+// Is the byte a continuation byte (10xxxxxx) of a UTF-8 character?
+bool is_continuation_byte(char byte) {
+    return (static_cast<unsigned char>(byte) & 0xC0U) == 0x80U;
 }
 
-char *append_int(long n, char *dest) {
-    static char digits[] = "0123456789";
-    char buf[32];
-    buf[31] = 0;
-    char *b = buf + 31;
-    do {
-        *(--b) = digits[n % 10];
-    } while ((n /= 10) > 0);
-    return append_str(b, dest);
+// The length of the message cut off after at most max_message_length bytes,
+// but not within a UTF-8 character
+std::string::size_type truncated_length(std::string_view message) {
+    if (message.size() <= max_message_length) {
+        return message.size();
+    }
+    // Cut off the start of a split character, too, which has at most 4 bytes.
+    auto length = max_message_length;
+    for (int i = 0; i < 3 && is_continuation_byte(message[length]); ++i) {
+        --length;
+    }
+    return length;
 }
-// NOLINTEND(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay,cppcoreguidelines-pro-bounds-constant-array-index,cppcoreguidelines-pro-bounds-pointer-arithmetic,misc-const-correctness)
 
 std::string default_pipe_path(std::string_view program) {
     // NOLINTNEXTLINE(concurrency-mt-unsafe)
@@ -120,31 +123,20 @@ std::optional<Notification> parse_notification(std::span<char *const> args) {
         contact = "";
     }
 
-    // NOLINTBEGIN(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay,cppcoreguidelines-pro-bounds-pointer-arithmetic)
-    char message[8192];
-    char *w = message;
-    *w++ = '<';
-    w = append_int((static_cast<long>(facility) << 3) +
-                       syslog_priority(state, service.empty()),
-                   w);
-    *w++ = '>';
-    *w++ = '@';
-    w = append_int(std::time(nullptr), w);
-    *w++ = ';';
-    w = append_int(atoi(sl_text), w);
-    *w++ = ';';
-    w = append_str(contact, w);
-    *w++ = ';';
-    *w++ = ' ';
-    w = append_str(hostname, w);
-    *w++ = ' ';
-    w = append_str(service.empty() ? "HOST" : service, w);
-    *w++ = ':';
-    *w++ = ' ';
-    w = append_str(text, w);
-    *w = 0;
-    return Notification{.remote = args[1], .message = message};
-    // NOLINTEND(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay,cppcoreguidelines-pro-bounds-pointer-arithmetic)
+    std::string message =
+        "<" +
+        std::to_string((static_cast<long>(facility) << 3) +
+                       syslog_priority(state, service.empty())) +
+        ">@" + std::to_string(std::time(nullptr)) + ";" +
+        std::to_string(atoi(sl_text)) + ";";
+    message += contact;
+    message += "; ";
+    message += hostname;
+    message += " ";
+    message += service.empty() ? "HOST" : service;
+    message += ": ";
+    message += text;
+    return Notification{.remote = args[1], .message = std::move(message)};
 }
 
 ExitCode send_via_syslog(const std::string &remote,
@@ -421,12 +413,9 @@ int main(int argc, char **argv) {
         remote = std::move(notification->remote);
         message = std::move(notification->message);
     } else {
-        // NOLINTBEGIN(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay)
-        char buffer[8192];
-        strncpy(buffer, args[1], sizeof(buffer) - 1);
-        message = buffer;
-        // NOLINTEND(cppcoreguidelines-avoid-c-arrays,modernize-avoid-c-arrays,cppcoreguidelines-pro-bounds-array-to-pointer-decay)
+        message = args[1];
     }
+    message.resize(truncated_length(message));
 
     // If we have a remote host, send the message to it via syslog.
     if (!remote.empty()) {
diff --git a/packages/cmk-ec/tests/component/test_mkevent.py b/packages/cmk-ec/tests/component/test_mkevent.py
index e0fd43db410..f68d5934ec3 100644
--- a/packages/cmk-ec/tests/component/test_mkevent.py
+++ b/packages/cmk-ec/tests/component/test_mkevent.py
@@ -138,6 +138,30 @@ def test_message_is_written_as_one_line(tmp_path: Path) -> None:
     assert (result.returncode, received) == (0, b"something happened\n")
 
 
+def test_long_message_is_truncated(tmp_path: Path) -> None:
+    # Only the length: mkevent once read past its unterminated buffer for such a message, which
+    # showed only if no NUL byte happened to follow the buffer on the stack.
+    result, received = _send_event(tmp_path, "x" * 10000)
+
+    assert (result.returncode, received) == (0, b"x" * 8191 + b"\n")
+
+
+@pytest.mark.parametrize(
+    "character",
+    [
+        # Cutting after 8191 bytes would split the 4096th one after its 1st byte.
+        pytest.param("ä", id="2 bytes"),
+        # Cutting after 8191 bytes would split the 2048th one after its 3rd byte.
+        pytest.param("😀", id="4 bytes"),
+    ],
+)
+def test_long_message_is_not_cut_within_a_character(tmp_path: Path, character: str) -> None:
+    result, received = _send_event(tmp_path, character * 5000)
+
+    encoded = character.encode()
+    assert (result.returncode, received) == (0, encoded * (8191 // len(encoded)) + b"\n")
+
+
 def test_notification_is_written_as_syslog_message(tmp_path: Path) -> None:
     result, received = _send_event(
         tmp_path, "-n", "1", "", "2", "myhost", "myservice", "it broke", "10", "admin"
@@ -221,6 +245,34 @@ def test_unset_sl_and_contact_become_0_and_empty(tmp_path: Path) -> None:
     assert re.fullmatch(rb"<10>@\d+;0;; myhost myservice: it broke\n", received)
 
 
+def test_negative_sl_is_written_with_its_sign(tmp_path: Path) -> None:
+    result, received = _send_event(
+        tmp_path, "-n", "1", "", "2", "myhost", "myservice", "it broke", "-5", "admin"
+    )
+
+    assert result.returncode == 0
+    assert re.fullmatch(rb"<10>@\d+;-5;admin; myhost myservice: it broke\n", received)
+
+
+def test_long_notification_text_is_truncated(tmp_path: Path) -> None:
+    result, received = _send_event(
+        tmp_path, "-n", "1", "", "2", "myhost", "myservice", "x" * 10000, "10", "admin"
+    )
+
+    assert (result.returncode, len(received)) == (0, 8192)
+    assert re.fullmatch(rb"<10>@\d+;10;admin; myhost myservice: x+\n", received)
+
+
+def test_long_notification_text_is_not_cut_within_a_character(tmp_path: Path) -> None:
+    result, received = _send_event(
+        tmp_path, "-n", "1", "", "2", "myhost", "myservice", "ä" * 5000, "10", "admin"
+    )
+
+    # With a header of even length, cutting after 8191 bytes would split an "ä".
+    assert (result.returncode, len(received)) == (0, 8191)
+    assert re.fullmatch(r"<10>@\d+;10;admin; myhost myservice: ä+\n", received.decode("utf-8"))
+
+
 def test_vanished_reader_is_an_error(tmp_path: Path) -> None:
     pipe = tmp_path / "events"
     os.mkfifo(pipe)
