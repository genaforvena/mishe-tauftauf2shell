+ */
+static bool pf_cmrpc_is_received_call (
+   const pf_session_info_t * p_sess,
+   const pf_rpc_header_t * p_rpc)
+{
+   return !p_sess->from_me &&
+          (p_rpc->sequence_nmb == p_sess->sequence_nmb_recv);
