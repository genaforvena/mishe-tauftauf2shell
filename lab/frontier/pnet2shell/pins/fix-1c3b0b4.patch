+TEST_F (CmrpcTest, CmrpcAlarmAfterMalformedAlarm)
+{
+   mock_set_pnal_udp_recvfrom_buffer (connect_req, sizeof (connect_req));
+   run_stack (TEST_UDP_DELAY);
