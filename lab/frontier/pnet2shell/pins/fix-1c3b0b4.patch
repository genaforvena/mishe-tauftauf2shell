+   /* An alarm notification that is cut off in the variable part is dropped */
+   receive_alarm_frame (net, alarm_notification_frame, 50);
+   run_stack (TEST_UDP_DELAY);
+   EXPECT_EQ (appdata.call_counters.alarm_calls, 0);
