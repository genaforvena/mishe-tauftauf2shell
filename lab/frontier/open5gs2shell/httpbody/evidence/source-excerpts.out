=== nghttp2-server-v2.8.0.c:1538-1611
 1538 static int on_data_chunk_recv(nghttp2_session *session, uint8_t flags,
 1539                               int32_t stream_id, const uint8_t *data,
 1540                               size_t len, void *user_data)
 1541 {
 1542     ogs_sbi_stream_t *stream = NULL;
 1543     ogs_sbi_request_t *request = NULL;
 1544     char *content = NULL;
 1545 
 1546     size_t offset = 0;
 1547 
 1548     ogs_assert(session);
 1549 
 1550     stream = nghttp2_session_get_stream_user_data(session, stream_id);
 1551     if (!stream) {
 1552         ogs_error("no stream [%d]", stream_id);
 1553         return 0;
 1554     }
 1555 
 1556     request = stream->request;
 1557     ogs_assert(request);
 1558 
 1559     ogs_assert(data);
 1560     ogs_assert(len);
 1561 
 1562 #define MAX_HTTP_CONTENT_LEN (256 * 1024 * 1024) /* 256MB */
 1563     if (request->http.content_length + len > MAX_HTTP_CONTENT_LEN) {
 1564         stream->memory_overflow = true;
 1565 
 1566         ogs_error("Payload too large : Content-Length[%d], len[%d]",
 1567                     (int)request->http.content_length, (int)len);
 1568 
 1569         ogs_sbi_server_send_error(stream,
 1570                 OGS_SBI_HTTP_STATUS_PAYLOAD_TOO_LARGE,
 1571                 NULL, "Payload too large", NULL, NULL);
 1572 
 1573         return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
 1574     }
 1575 
 1576     if (request->http.content == NULL) {
 1577         ogs_assert(request->http.content_length == 0);
 1578         ogs_assert(offset == 0);
 1579 
 1580         content = (char*)ogs_malloc(len + 1);
 1581     } else {
 1582         ogs_assert(request->http.content_length != 0);
 1583 
 1584         content = (char*)ogs_realloc(
 1585                 request->http.content, request->http.content_length + len + 1);
 1586     }
 1587 
 1588     if (!content) {
 1589         stream->memory_overflow = true;
 1590 
 1591         ogs_error("Memory Overflow : Content-Length[%d], len[%d]",
 1592                     (int)request->http.content_length, (int)len);
 1593         ogs_log_hexdump(OGS_LOG_ERROR, data, len);
 1594 
 1595         ogs_sbi_server_send_error(stream,
 1596                 OGS_SBI_HTTP_STATUS_SERVICE_UNAVAILABLE,
 1597                 NULL, "Memory Overflow", NULL, NULL);
 1598 
 1599         return NGHTTP2_ERR_TEMPORAL_CALLBACK_FAILURE;
 1600     }
 1601 
 1602     request->http.content = content;
 1603 
 1604     offset = request->http.content_length;
 1605     request->http.content_length += len;
 1606 
 1607     memcpy(request->http.content + offset, data, len);
 1608     request->http.content[request->http.content_length] = '\0';
 1609 
 1610     return 0;
 1611 }
